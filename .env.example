# Copy to .env and fill in. Never commit .env.

# Habitica: Settings > Site Data (User ID and API Token)
HABITICA_USER_ID=
HABITICA_API_TOKEN=

# Notion: internal integration token; the integration needs access to the "Hábitos" page
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
# Optional, for reference only: the API calls use the data source ID
NOTION_DATABASE_ID=
